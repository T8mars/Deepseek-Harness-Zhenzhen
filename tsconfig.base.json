{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "skipLibCheck": true, "composite": true,
    "declaration": true, "emitDeclarationOnly": true, "noEmitOnError": true,
    "jsx": "react-jsx", "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true, "types": ["node"],
    "lib": ["ES2023", "DOM", "ESNext.Decorators"],
    "ignoreDeprecations": "6.0"
  }
}
