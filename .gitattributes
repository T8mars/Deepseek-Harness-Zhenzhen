# Preserve patch bytes and SHA-256, including the required space on empty
# unified-diff context lines. Source whitespace checks remain unchanged.
integrations/canvas/*.patch -text whitespace=-blank-at-eol
*.cmd text eol=crlf
# Immutable reviewed source/license snapshots: preserve their SHA-256 bytes on
# Windows checkouts as well as in Git. Do not normalize the fixture validator.
contracts/fixtures/canvas-approval/approvals.cjs -text
contracts/fixtures/canvas-approval/LICENSE -text
# Raw first-party npm payloads must match across Git checkout policies. Keep
# these rules specific to known text formats; future binary assets are untouched.
packages/dsh-zhen/LICENSE text eol=lf
packages/dsh-zhen/NOTICE.md text eol=lf
packages/dsh-zhen/THIRD_PARTY_NOTICES.md text eol=lf
packages/dsh-zhen/package.json text eol=lf
packages/dsh-zhen/cordis.patch.yml text eol=lf
packages/dsh-zhen/catalog/*.json text eol=lf
market/skills.v1.json text eol=lf
# Candidate receipts compare executing script bytes with immutable Git blobs.
scripts/gateway-smoke-core.mjs text eol=lf
scripts/real-gateway-smoke.mjs text eol=lf
scripts/check-smoke-ci.mjs text eol=lf
packages/dsh-zhen/skills/*/SKILL.md text eol=lf
packages/dsh-zhen/skills/*/manifest.json text eol=lf
