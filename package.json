{
  "name": "dsh-zhen-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --build tsconfig.host.json tsconfig.client.json",
    "typecheck:clean": "node scripts/typecheck-clean.mjs",
    "test": "node --test --test-concurrency=1 contracts/*.test.mjs packages/dsh-zhen/test/*.test.mjs",
    "check:private": "node scripts/check-private.mjs",
    "check": "npm run build && npm run typecheck:clean && npm test && npm run check:private",
    "start": "node scripts/start-local.mjs",
    "start:prepared": "node scripts/launch.mjs",
    "prepare:hooks": "node scripts/install-hooks.mjs",
    "pack:bundle": "node scripts/pack.mjs",
    "pack:art": "node scripts/pack-art.mjs",
    "smoke:install": "node scripts/smoke-install.mjs",
    "verify:canvas-native": "node scripts/verify-native-canvas.mjs",
    "verify:canvas-backup": "node scripts/verify-canvas-backup.mjs",
    "verify:local-art": "node scripts/verify-local-art.mjs",
    "evaluate:rag:corpus": "node scripts/evaluate-rag-corpus.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.2.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-agent-default-model": "0.2.1-rc.2",
    "@deepseek-ai/dsh-agent-loop": "0.2.1-rc.2",
    "@deepseek-ai/dsh-api-remotes": "0.2.1-rc.2",
    "@deepseek-ai/dsh-attachment": "0.2.1-rc.2",
    "@deepseek-ai/dsh-attachment-local": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-theme": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-tool": "0.2.1-rc.2",
