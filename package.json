    "@deepseek-ai/schemastery": "3.18.5",
    "@types/node": "22.18.12",
    "@types/react": "19.2.2",
    "@types/semver": "7.7.1",
    "esbuild": "0.25.11",
    "fflate": "0.8.3",
    "pnpm": "10.34.7",
