    "@deepseek-ai/dsh-launch-environment": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.1-rc.2",
    "@deepseek-ai/dsh-mcp-client": "0.2.1-rc.2",
    "@deepseek-ai/dsh-mcp-resources": "0.2.1-rc.2",
    "@deepseek-ai/dsh-plugin-market-index": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
